{
  "uid": "fleet-rollout",
  "title": "Fleet rollout",
  "description": "Rollout progress, halts, rollbacks, and the health of the control plane.",
  "tags": [
    "fleet-rollout"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "rollout",
        "label": "Rollout",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(fleet_rollout_rollout_info, rollout)",
          "refId": "rollout"
        },
        "definition": "label_values(fleet_rollout_rollout_info, rollout)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Rollouts in progress",
      "description": "Rollouts that have started and not finished.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(fleet_rollout_rollout_info{state=~\"running|soaking|paused|rolling_back\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Halts in range",
      "description": "Rollouts the engine halted, by reason, over the selected time range.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fleet_rollout_rollout_halts_total[$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Engine leader",
      "description": "1 when an instance holds the engine lease. 0 means nothing is advancing rollouts.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fleet_rollout_engine_leader) or vector(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Device requests shed",
      "description": "Device requests turned away with 503 over the selected range, because their pool was full.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fleet_rollout_device_requests_shed_total[$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Rollouts",
      "description": "Each recent rollout and its state.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fleet_rollout_rollout_info{rollout=~\"$rollout\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stage outcomes",
      "description": "Devices in the selected rollouts' stages, by outcome.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (fleet_rollout_stage_devices{rollout=~\"$rollout\"})",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rollback progress",
      "description": "Devices that need a rollback, and how many are restored, failed, or unresolved.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (fleet_rollout_rollback_devices{rollout=~\"$rollout\"})",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Engine decisions",
      "description": "State changes the engine made, per minute, by event.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (increase(fleet_rollout_engine_decisions_total[1m]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Device reports",
      "description": "Reports per second, by what became of them.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(fleet_rollout_device_reports_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests by route",
      "description": "HTTP requests per second, by route.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(fleet_rollout_http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request latency, p95",
      "description": "The 95th percentile of request duration, by route.",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(fleet_rollout_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Shed device requests",
      "description": "Device requests turned away per second, by pool.",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (rate(fleet_rollout_device_requests_shed_total[1m]))",
          "legendFormat": "{{pool}}"
        }
      ]
    }
  ]
}
